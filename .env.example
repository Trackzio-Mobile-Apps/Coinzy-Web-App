# Experts API — Android gradle.properties:
#   EXPERTS_BASE_URL_QA  = https://api.coinzy-experts-qa.trackzio.com/   (dev flavor)
#   EXPERTS_BASE_URL     = https://coinzy-experts-api.trackzio.com/      (prod flavor)
# Default when unset = QA (pairs with COINZY_API_ORIGIN coins-api.trackzio.com).
# Production web: set COINZY_EXPERTS_API_ORIGIN to the prod URL.
# COINZY_EXPERTS_API_ORIGIN=https://api.coinzy-experts-qa.trackzio.com
# COINZY_EXPERTS_API_ORIGIN=https://coinzy-experts-api.trackzio.com
#
# Admin API key for Trackzio staff dummy credit grants (`POST /api/experts/payments/dummy`).
# Only @trackzio.com sessions can call that route; key stays server-side.
# COINZY_EXPERTS_ADMIN_API_KEY=

# Firebase web app (Console → Project settings → Your apps → Web)
# Dev / local: coinzy-dev defaults in lib/firebase/config.ts when these are empty
# Production deploy (required): create a Web app under project coinzy-26a4d and set all below.
# Production builds throw if missing (Feed / Google auth). Also enable Auth → Google;
# add authorized domains (localhost, production host).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
