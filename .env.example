# Catalogue / auth / marketplace (defaults to prod):
# COINZY_API_ORIGIN=https://coins-api-prod.trackzio.com
# COINZY_AUTH_API_ORIGIN=https://coins-api-prod.trackzio.com
# COINZY_MARKETPLACE_API_ORIGIN=https://coins-api-prod.trackzio.com
#
# Experts API:
#   EXPERTS_BASE_URL_QA  = https://api.coinzy-experts-qa.trackzio.com/   (dev)
#   EXPERTS_BASE_URL     = https://coinzy-experts-api.trackzio.com/      (prod)
# COINZY_EXPERTS_API_ORIGIN=https://api.coinzy-experts-qa.trackzio.com
# COINZY_EXPERTS_API_ORIGIN=https://coinzy-experts-api.trackzio.com
#
# Auth CSRF (comma-separated site origins): COINZY_ALLOWED_ORIGINS=https://your-site.netlify.app
#
# Admin API key for Trackzio staff dummy credit grants (`POST /api/experts/payments/dummy`).
# Only @trackzio.com sessions can call that route; key stays server-side.
# COINZY_EXPERTS_ADMIN_API_KEY=

# Firebase web app (Console → Project settings → Your apps → Web)
# Optional override. Empty → coinzy-26a4d web app in lib/firebase/config.ts (Android release).
# Experts uploads and Feed both use that project. Also enable Auth → Google;
# add authorized domains (localhost, production host).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
